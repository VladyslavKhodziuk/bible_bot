# ─────────────────────────────────────────────────────────────────────────────
# Bible Way — переменные окружения
# Скопируй этот файл в `.env` на сервере и заполни значения. Реальный `.env`
# в git НЕ коммитится (см. .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# ── Обязательные ─────────────────────────────────────────────────────────────

# Токен Telegram-бота от @BotFather. ОБЯЗАТЕЛЬНО.
# Для прода используй ОТДЕЛЬНОГО бота (не того, что для разработки),
# иначе long-polling будет конфликтовать (409 Conflict).
BOT_TOKEN=

# Google Gemini API key для AI-пастыря. ОБЯЗАТЕЛЬНО.
# Получить: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ── Админы и поддержка ───────────────────────────────────────────────────────

# Telegram user_id админов через запятую. Им уходят:
#   - алерты о сбоях бота;
#   - уведомления о фидбеке (если фидбэк-группы не заданы);
#   - daily/monthly отчёты (если REPORT_CHAT_ID не задан).
# Свой ID можно узнать у @userinfobot.
ADMIN_IDS=

# Таймзона по умолчанию (IANA). Используется для новых юзеров и как fallback.
DEFAULT_TZ=Europe/Madrid

# ── Группы для уведомлений о фидбеке ─────────────────────────────────────────
# ID Telegram-группы (число вида -100..., бот должен быть в группе админом).
# Если не задано — фидбек уходит в ЛС админам (ADMIN_IDS).
# Как получить chat_id: переслать любое сообщение из группы в бот → /chatid.

FEEDBACK_REVIEW_CHAT_ID=
FEEDBACK_BUG_CHAT_ID=
FEEDBACK_IDEA_CHAT_ID=

# ── Аналитика ────────────────────────────────────────────────────────────────

# Группа/чат, куда раз в сутки уходит сводка активности. Если не задан — в ЛС админам.
REPORT_CHAT_ID=

# Время отправки daily report'а (HH:MM, локальное время сервера).
REPORT_TIME=22:00

# Дни месяца для monthly report'а и cleanup'а activity_hourly.
MONTHLY_REPORT_DAY=25
CLEANUP_DAY=5

# Throttling: не больше N действий от одного юзера за WINDOW секунд.
THROTTLE_MAX_EVENTS=15
THROTTLE_WINDOW_SEC=3

# Сколько дней хранить тексты AI-запросов (приватность). Минимум 45 — иначе
# месячный отчёт будет недосчитывать.
AI_REQUEST_RETENTION_DAYS=90

# ── Алерты и health-check ────────────────────────────────────────────────────

# Дедуп: одинаковые алерты не шлются чаще, чем раз в N секунд.
ALERT_COOLDOWN_SEC=300

# Пороги ресурсного алерта (в процентах).
ALERT_MEM_THRESHOLD=90
ALERT_DISK_THRESHOLD=90

# ── Донаты ───────────────────────────────────────────────────────────────────
# Все опциональны — кнопка отображается только если соответствующая переменная
# непуста. Telegram Stars работает всегда (не требует env).

DONATE_MONOBANK_URL=
DONATE_MONOBANK_CARD=
DONATE_REVOLUT_URL=
DONATE_PAYPAL_URL=
DONATE_CRYPTO_URL=
# Bizum (Испания) — номер телефона получателя.
DONATE_BIZUM_PHONE=
